{
  "name": "vistablox-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture": "depcruise src --config dependency-cruiser.config.cjs",
    "check": "npm run typecheck && npm run architecture && npm test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "contracts:compile": "npm --prefix contracts run compile",
    "contracts:test": "npm --prefix contracts test",
    "contracts:export-abi": "node scripts/export-contract-abis.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@better-auth/expo": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@peculiar/x509": "^2.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "13.3.3",
    "asn1js": "^3.0.10",
    "better-auth": "1.7.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jose": "6.2.10",
    "nodemailer": "9.1.0",
    "otplib": "13.5.0",
    "pg": "8.16.3",
    "pg-boss": "12.29.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "ulid": "3.0.2",
    "viem": "^2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "18.2.0",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
