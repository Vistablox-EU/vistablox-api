NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WEBAUTHN_RP_NAME=VistaBlox
# Defaults to BETTER_AUTH_URL's hostname and origin when left empty.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Frontend page that collects the invitation token and initial password.
STAFF_INVITATION_ACCEPT_URL=http://localhost:3000/staff/accept-invitation
# Frontend page that accepts Better Auth's staff password-reset callback.
STAFF_RECOVERY_REDIRECT_URL=http://localhost:3000/staff/reset-password
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Native-client OIDC (mobile/desktop) always mounts at /oidc; both values
# below are required. OIDC_JWKS signs ID tokens and is private key
# material — generate a real one per environment (see README's "Local
# setup" section for a one-line generator) rather than sharing this value.
OIDC_JWKS=
# Comma-separated allowlist of the native app's registered redirect URIs
# (a custom URI scheme for mobile, a loopback address for desktop).
OIDC_NATIVE_REDIRECT_URIS=com.vistablox.app:/oauth/callback

# Configure both values together to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="VistaBlox <no-reply@example.com>"

# Managed EU Redis/Valkey cache for the allow-listed Didit display profile.
# Configure it without routine backups. The API continues without names if unavailable.
PROFILE_CACHE_URL=

# Same managed Redis/Valkey deployment (may be the same instance as
# PROFILE_CACHE_URL), used for the general-purpose /v1 rate limiter.
# Rate limiting is skipped, not enforced fail-closed, while unconfigured.
RATE_LIMIT_CACHE_URL=

# Private, API-proxied document storage. Configure all four values together.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DOCUMENT_BUCKET=

# Configure the required values together to enable Didit hosted individual KYC.
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Optional separate hosted Address Verification workflow for owner intake.
DIDIT_POA_WORKFLOW_ID=
# All DIDIT_* values below must be set together or all left empty (KYC
# disabled) — an empty DIDIT_API_KEY with any of these filled in fails
# environment validation at startup.
DIDIT_CALLBACK_URL=
DIDIT_WEBHOOK_SECRET=
DIDIT_APPLICATION_ID=
DIDIT_ENVIRONMENT=

# Configure the required values together to enable reservation funding
# (Coinbase CDP onramp, AD-255). The funding rail also stays closed by a
# separate in-code default even once these are set — see
# docs/investor-offering.md#reservation-creation.
COINBASE_CDP_API_BASE_URL=https://api.developer.coinbase.com
COINBASE_CDP_PAY_HOSTED_URL=https://pay.coinbase.com/buy/select-asset
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_ONRAMP_BLOCKCHAIN=base
# All three COINBASE_CDP_API_KEY_ID / COINBASE_CDP_API_KEY_SECRET /
# COINBASE_ONRAMP_REDIRECT_URL values must be set together or all left empty.
COINBASE_ONRAMP_REDIRECT_URL=

# Stays "false" until someone completes the pre-launch checklist in
# docs/investor-offering.md#the-funding-rail-still-stays-closed-by-default —
# this codebase cannot verify Coinbase's live EUR/Base support on its own,
# and setting this without the COINBASE_CDP_* values above has no effect.
RESERVATION_FUNDING_RAIL_ENABLED=false

# Runtime traffic must use Neon's pooled connection.
DATABASE_URL=postgresql://user:password@pooler.example.neon.tech/vistablox?sslmode=require

# Prisma migrations must use Neon's direct, non-pooled connection.
DIRECT_DATABASE_URL=postgresql://user:password@example.neon.tech/vistablox?sslmode=require
