NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WEBAUTHN_RP_NAME=VistaBlox
# Defaults to BETTER_AUTH_URL's hostname and origin when left empty.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Required in production to serve native passkey association metadata.
PASSKEY_APPLE_TEAM_ID=
PASSKEY_ANDROID_SHA256_CERT_FINGERPRINTS=
# Required for native Android passkey creation/authentication to verify at
# all: the "android:apk-key-hash:<base64url>" origin(s) Credential Manager
# sends, one per signing key (debug keystore, Play App Signing, ...).
# Distinct from the hex fingerprints above, which are for assetlinks.json.
PASSKEY_ANDROID_ORIGINS=
# Frontend page that exchanges an invitation token for passkey enrollment.
STAFF_INVITATION_ACCEPT_URL=http://localhost:3000/staff/accept-invitation
# Frontend page that enrolls a replacement staff passkey.
STAFF_RECOVERY_REDIRECT_URL=http://localhost:3000/staff/recover-account
# Mobile deep link that enrolls a replacement customer passkey.
ACCOUNT_RECOVERY_REDIRECT_URL=com.vistablox.app://recover-account
# Include the mobile app's custom URI scheme so Better Auth's origin check
# accepts requests from the native client (the Expo dev client's exp://
# scheme is added automatically outside production, no entry needed here).
AUTH_TRUSTED_ORIGINS=http://localhost:3000,com.vistablox.app://

# Customer login is OAuth followed by a passkey. Each identity provider has
# an explicit feature flag; credentials alone never enable it.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_OAUTH_ENABLED=false
# Apple Services ID used by the web OAuth callback.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 .p8 contents. Literal \\n sequences are accepted.
APPLE_PRIVATE_KEY=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="VistaBlox <no-reply@example.com>"

# Managed EU Redis/Valkey cache for the allow-listed Didit display profile.
# Configure it without routine backups. The API continues without names if
# unavailable. Read by src/kyc-server.ts too (same value, its own optional
# key in kyc-environment.ts) -- that's the process that actually invalidates
# it on a KYC state change now.
PROFILE_CACHE_URL=

# Same managed Redis/Valkey deployment (may be the same instance as
# PROFILE_CACHE_URL), used for the general-purpose /v1 rate limiter.
# Rate limiting is skipped, not enforced fail-closed, while unconfigured.
RATE_LIMIT_CACHE_URL=

# Private, API-proxied document storage. Configure all four values together.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DOCUMENT_BUCKET=

# One shared .env for local dev -- every DIDIT_* / INTERNAL_KYC_API_SECRET
# key below is listed once, even though both this API (account recovery's
# own re-verification flow only -- /v1/kyc and /internal/v1/kyc-accounts now
# forward to the KYC service below) and src/kyc-server.ts read it. Real
# deployments configure the same values as two independent copies (see
# docker-compose.staging.yml's "vistablox-kyc" service block) -- they're
# read here from one file only because local dev runs every process from
# the one .env, not because it's a single shared credential store.
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# This API requires its three DIDIT_* values configured together or all
# left empty (account recovery's Didit usage is optional); the KYC service
# requires all of its own outright, no disabled mode -- see
# src/config/kyc-environment.ts.
DIDIT_CALLBACK_URL=
# Optional separate hosted Address Verification workflow for owner intake,
# read by the KYC service only.
DIDIT_POA_WORKFLOW_ID=
# Read by the KYC service only (webhook signature verification / event
# classification) -- this API never touches these three.
DIDIT_APPLICATION_ID=
DIDIT_ENVIRONMENT=
DIDIT_WEBHOOK_SECRET=

# This API's client for the KYC service (src/modules/identity/
# infrastructure/kyc-service.client.ts) -- required outright, /v1/kyc isn't
# an optional feature the way Didit-as-a-whole is. KYC_SERVICE_URL is the
# compose-internal hostname (docker-compose.yml's "kyc" service /
# docker-compose.staging.yml's "vistablox-kyc" service -- different service
# names, so different hostnames, for the same logical service). The KYC
# service verifies these calls with its own INTERNAL_KYC_API_SECRET, which
# must be the exact same value as this one (internal-api-signature.ts) --
# not a Didit credential; generate it the same way as BETTER_AUTH_SECRET.
KYC_SERVICE_URL=http://kyc:3000
INTERNAL_KYC_API_SECRET=

# Configure the required values together to enable reservation funding
# (Coinbase CDP onramp, AD-255). The funding rail also stays closed by a
# separate in-code default even once these are set — see
# docs/investor-offering.md#reservation-creation.
COINBASE_CDP_API_BASE_URL=https://api.developer.coinbase.com
COINBASE_CDP_PAY_HOSTED_URL=https://pay.coinbase.com/buy/select-asset
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_ONRAMP_BLOCKCHAIN=base
# All three COINBASE_CDP_API_KEY_ID / COINBASE_CDP_API_KEY_SECRET /
# COINBASE_ONRAMP_REDIRECT_URL values must be set together or all left empty.
COINBASE_ONRAMP_REDIRECT_URL=

# Stays "false" until someone completes the pre-launch checklist in
# docs/investor-offering.md#the-funding-rail-still-stays-closed-by-default —
# this codebase cannot verify Coinbase's live EUR/Base support on its own,
# and setting this without the COINBASE_CDP_* values above has no effect.
RESERVATION_FUNDING_RAIL_ENABLED=false

# Dormant by default, matching AD-234's settlement-layer pattern: built and
# testable, but not wired to run automatically until deliberately turned on.
OPERATING_DISTRIBUTION_ENABLED=false

# Optional on-chain settlement integration (AD-163): mint/burn on the
# shared VistaBloxProperty contract and open/finalize IPO escrow campaigns on
# VistaBloxIpoEscrow. Same all-together-or-none shape as the Coinbase CDP
# settings above -- leave every value below empty until real contracts are
# deployed and an operator wallet is funded; this simply doesn't run until
# then.
CHAIN_NETWORK=
CHAIN_RPC_URL=
CHAIN_OPERATOR_PRIVATE_KEY=
VISTABLOX_PROPERTY_CONTRACT_ADDRESS=
VISTABLOX_IPO_ESCROW_CONTRACT_ADDRESS=
EURC_TOKEN_ADDRESS=
# Placeholder single platform-wide escrow-sweep destination until real
# per-PIV governed multisigs exist -- see VistaBloxIpoEscrow.updateTreasury.
PIV_TREASURY_ADDRESS=

# Local development uses a local PostgreSQL 18 instance (AD-257) — this
# default matches prisma.config.ts's own local-dev fallback role, so it works
# out of the box against `createdb -U prisma vistablox` locally, or against
# docker-compose.yml's postgres service (see its README section for that
# path's own vistablox/vistablox credentials instead). Production instead
# points this at Neon's pooled connection (DEPLOYMENT_TOPOLOGY.md).
DATABASE_URL=postgresql://prisma:prisma@localhost:5432/vistablox

# Prisma migrations. Locally this is the same local instance as DATABASE_URL
# above (no pooling to route around). Production instead points this at
# Neon's direct, non-pooled connection.
DIRECT_DATABASE_URL=postgresql://prisma:prisma@localhost:5432/vistablox

# Set to run the integration test suite (tests/*.integration.test.ts) against
# a local PostgreSQL 18 database — unset, those tests are skipped rather than
# failing. Use a separate database from DATABASE_URL above (e.g. `createdb -U
# prisma vistablox_test`) so test runs never touch interactive dev data
# (AD-257; see vistablox-design-docs' INTEGRATION_TESTS.md for full setup).
TEST_DATABASE_URL=postgresql://prisma:prisma@localhost:5432/vistablox_test
