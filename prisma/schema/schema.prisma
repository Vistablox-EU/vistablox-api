generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["account", "identity", "origination", "offering", "money", "settlement", "audit", "platform", "rental", "auth"]
}

model Account {
  id                    String   @id @map("account_id")
  betterAuthUserId      String   @unique @map("better_auth_user_id")
  protectedContactEmail String?  @map("protected_contact_email")
  status                String   @default("active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  staffRoles                     StaffRoleAssignment[]
  staffWebAuthnCredentials       StaffWebAuthnCredential[]
  staffWebAuthnChallenges        StaffWebAuthnChallenge[]
  staffMfaSessions               StaffSessionMfa[]
  staffInvitationsSent           StaffInvitation[]           @relation("StaffInvitationIssuer")
  acceptedStaffInvitation        StaffInvitation?            @relation("StaffInvitationAcceptance")
  loginMethods                   LoginMethod[]
  sessions                       Session[]
  rentCollectionsRecorded        RentCollection[]
  operatingDistributionsApproved OperatingDistribution[]
  recoveryCases                  AccountRecoveryCase[]       @relation("RecoverySubject")
  primaryRecoveryReviews         AccountRecoveryCase[]       @relation("PrimaryRecoveryReviewer")
  secondaryRecoveryReviews       AccountRecoveryCase[]       @relation("SecondaryRecoveryReviewer")
  kycEligibility                 KycEligibility?
  kycHistory                     KycEligibilityHistory[]
  originationCases               OriginationCase[]           @relation("CaseApplicant")
  reviewedCases                  OriginationCase[]           @relation("FounderCaseReviewer")
  submittedRevisions             SubmissionRevision[]
  workstreamEvents               WorkstreamAssignmentEvent[] @relation("WorkstreamActor")
  targetReviewerEvents           WorkstreamAssignmentEvent[] @relation("WorkstreamTargetReviewer")
  raisedIntegrityFlags           CaseIntegrityFlag[]         @relation("IntegrityFlagRaiser")
  resolvedIntegrityFlags         CaseIntegrityFlag[]         @relation("IntegrityFlagResolver")
  proposedInformationRequests    InformationRequest[]        @relation("InformationRequestProposer")
  publishedInformationRequests   InformationRequest[]        @relation("InformationRequestPublisher")
  caseMessages                   CaseMessage[]
  requestedExecutionEvents       LegalExecutionEvent[]
  reservations                   Reservation[]
  classifiedMaterialityRecords   MaterialityRecord[]
  firstSweepApprovals            TreasurySweepBatch[]        @relation("FirstSweepApprover")
  secondSweepApprovals           TreasurySweepBatch[]        @relation("SecondSweepApprover")
  payouts                        Payout[]
  walletRegistration             WalletRegistration?
  positions                      PositionLedger[]
  auditEntries                   AuditLog[]
  idempotencyKeys                IdempotencyKey[]
  updatedSettings                PlatformSetting[]
  preferences                    AccountPreferences?
  closureRequests                AccountClosureRequest[] @relation("ClosureRequestSubject")
  resolvedClosureRequests        AccountClosureRequest[] @relation("ClosureRequestResolver")
  devices                        Device[]

  @@map("accounts")
  @@schema("account")
}

model AccountPreferences {
  accountId       String   @id @map("account_id")
  dealAlertsEmail Boolean  @default(true) @map("deal_alerts_email")
  statementsEmail Boolean  @default(true) @map("statements_email")
  marketingEmail  Boolean  @default(false) @map("marketing_email")
  locale          String   @default("en-US") @map("locale")
  timezone        String   @default("UTC") @map("timezone")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@map("account_preferences")
  @@schema("account")
}

model KycEligibility {
  accountId                       String    @id @map("account_id")
  diditReference                  String?   @unique(map: "kyc_eligibility_didit_reference_key") @map("didit_reference")
  eligibilityState                String    @default("not_started") @map("eligibility_state")
  providerStatus                  String?   @map("provider_status")
  operationalSubstatus            String    @default("kyc_not_started") @map("operational_substatus")
  providerUpdatedAt               DateTime? @map("provider_updated_at") @db.Timestamptz(6)
  sessionStartId                  String?   @unique(map: "kyc_eligibility_session_start_id_key") @map("session_start_id")
  proofOfAddressDiditReference    String?   @unique(map: "kyc_eligibility_poa_didit_reference_key") @map("proof_of_address_didit_reference")
  proofOfAddressProviderStatus    String?   @map("proof_of_address_provider_status")
  proofOfAddressProviderUpdatedAt DateTime? @map("proof_of_address_provider_updated_at") @db.Timestamptz(6)
  proofOfAddressSessionStartId    String?   @unique(map: "kyc_eligibility_poa_session_start_id_key") @map("proof_of_address_session_start_id")
  proofOfAddressStatus            String    @default("not_started") @map("proof_of_address_status")
  residenceCountryCode            String?   @map("residence_country_code")
  taxResidenceCountryCode         String?   @map("tax_residence_country_code")
  proofOfAddressCurrentUntil      DateTime? @map("proof_of_address_current_until") @db.Timestamptz(6)
  lastVerifiedAt                  DateTime? @map("last_verified_at") @db.Timestamptz(6)
  everRequiredManualReview        Boolean   @default(false) @map("ever_required_manual_review")
  renewalDueAt                    DateTime? @map("renewal_due_at") @db.Timestamptz(6)
  updatedAt                       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@map("kyc_eligibility")
  @@schema("identity")
}

model KycEligibilityHistory {
  id            String   @id @map("history_id")
  accountId     String   @map("account_id")
  previousState String   @map("previous_state")
  newState      String   @map("new_state")
  reasonCode    String   @map("reason_code")
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "idx_kyc_history_account")
  @@map("kyc_eligibility_history")
  @@schema("identity")
}

model Property {
  id                     String   @id @map("property_id")
  propertyType           String   @default("residential") @map("property_type")
  countryCode            String   @map("country_code")
  city                   String?
  addressLine            String?  @map("address_line")
  landRegistryReference  String?  @map("land_registry_reference")
  latitude               Float?
  longitude              Float?
  ownerDeclaredValueEur  Decimal  @map("owner_declared_value_eur") @db.Decimal(15, 2)
  hasExistingEncumbrance Boolean  @default(false) @map("has_existing_encumbrance")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cases OriginationCase[]
  piv   Piv?

  @@map("properties")
  @@schema("origination")
}

model LegalPractice {
  id          String @id @map("legal_practice_id")
  name        String
  countryCode String @map("country_code")
  status      String @default("active")

  staffRoles       StaffRoleAssignment[]
  cases            OriginationCase[]
  targetEvents     WorkstreamAssignmentEvent[]
  staffInvitations StaffInvitation[]

  @@map("legal_practices")
  @@schema("origination")
}

model AppraisalFirm {
  id          String @id @map("appraisal_firm_id")
  name        String
  countryCode String @map("country_code")
  status      String @default("active")

  staffRoles       StaffRoleAssignment[]
  cases            OriginationCase[]
  targetEvents     WorkstreamAssignmentEvent[]
  staffInvitations StaffInvitation[]

  @@map("appraisal_firms")
  @@schema("origination")
}

model CorridorClearance {
  id                  String    @id @map("corridor_clearance_id")
  countryCode         String    @map("country_code")
  structurePattern    String    @map("structure_pattern")
  distributionPosture String    @map("distribution_posture")
  gateStatus          String    @default("not_yet_cleared") @map("gate_status")
  counselMemoRef      String?   @map("counsel_memo_ref")
  clearedAt           DateTime? @map("cleared_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  pivs Piv[]

  @@unique([countryCode, structurePattern, distributionPosture])
  @@map("corridor_clearances")
  @@schema("origination")
}

model OriginationCase {
  id                            String    @id @map("case_id")
  propertyId                    String    @map("property_id")
  applicantAccountId            String    @map("applicant_account_id")
  stage                         String    @default("draft")
  canReopen                     Boolean   @default(false) @map("can_reopen")
  currentSubmissionRevisionId   String?   @map("current_submission_revision_id")
  rejectedAt                    DateTime? @map("rejected_at") @db.Timestamptz(6)
  withdrawnAt                   DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  expiredAt                     DateTime? @map("expired_at") @db.Timestamptz(6)
  approvedForFinalOfferingAt    DateTime? @map("approved_for_final_offering_at") @db.Timestamptz(6)
  rejectionReasonCode           String?   @map("rejection_reason_code")
  rejectionNotes                String?   @map("rejection_notes")
  founderReviewNotes            String?   @map("founder_review_notes")
  reviewedByAccountId           String?   @map("reviewed_by_account_id")
  approvedAt                    DateTime? @map("approved_at") @db.Timestamptz(6)
  legalExecutionEventRefs       String[]  @map("legal_execution_event_refs")
  ipoPeriodDays                 Int?      @map("ipo_period_days")
  ipoEndAt                      DateTime? @map("ipo_end_at") @db.Timestamptz(6)
  ipoValueEur                   Decimal?  @map("ipo_value_eur") @db.Decimal(15, 2)
  legalPracticeId               String?   @map("legal_practice_id")
  legalDocumentRefs             String[]  @map("legal_document_refs")
  legalStructuringCompletedAt   DateTime? @map("legal_structuring_completed_at") @db.Timestamptz(6)
  appraisalFirmId               String?   @map("appraisal_firm_id")
  appraisalValueOpinionEur      Decimal?  @map("appraisal_value_opinion_eur") @db.Decimal(15, 2)
  appraisalDocumentRefs         String[]  @map("appraisal_document_refs")
  appraisalCompletedAt          DateTime? @map("appraisal_completed_at") @db.Timestamptz(6)
  postIpoStructuringCompletedAt DateTime? @map("post_ipo_structuring_completed_at") @db.Timestamptz(6)
  exclusivityCommencedAt        DateTime? @map("exclusivity_commenced_at") @db.Timestamptz(6)
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  property                  Property                       @relation(fields: [propertyId], references: [id])
  applicant                 Account                        @relation("CaseApplicant", fields: [applicantAccountId], references: [id])
  reviewer                  Account?                       @relation("FounderCaseReviewer", fields: [reviewedByAccountId], references: [id])
  legalPractice             LegalPractice?                 @relation(fields: [legalPracticeId], references: [id])
  appraisalFirm             AppraisalFirm?                 @relation(fields: [appraisalFirmId], references: [id])
  currentSubmissionRevision SubmissionRevision?            @relation("CurrentSubmissionRevision", fields: [currentSubmissionRevisionId], references: [id])
  revisions                 SubmissionRevision[]           @relation("CaseRevisions")
  evidence                  DocumentaryScreeningEvidence[]
  workstreamEvents          WorkstreamAssignmentEvent[]
  integrityFlags            CaseIntegrityFlag[]
  informationRequests       InformationRequest[]
  threads                   CaseThread[]
  executionEvents           LegalExecutionEvent[]
  pivs                      Piv[]

  @@index([propertyId], map: "idx_cases_property")
  @@index([applicantAccountId], map: "idx_cases_applicant")
  @@index([currentSubmissionRevisionId], map: "idx_cases_current_revision")
  @@index([legalPracticeId], map: "idx_cases_legal_practice")
  @@index([appraisalFirmId], map: "idx_cases_appraisal_firm")
  @@index([stage], map: "idx_cases_stage")
  @@map("origination_cases")
  @@schema("origination")
}

model SubmissionRevision {
  id                   String   @id @map("revision_id")
  caseId               String   @map("case_id")
  revisionNumber       Int      @map("revision_number")
  submittedAt          DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submittedByAccountId String   @map("submitted_by_account_id")
  submissionData       Json     @map("submission_data") @db.JsonB
  reason               String

  case              OriginationCase                @relation("CaseRevisions", fields: [caseId], references: [id])
  currentForCases   OriginationCase[]              @relation("CurrentSubmissionRevision")
  submittedBy       Account                        @relation(fields: [submittedByAccountId], references: [id])
  evidence          DocumentaryScreeningEvidence[]
  resolvingRequests InformationRequest[]

  @@unique([caseId, revisionNumber])
  @@index([submittedByAccountId], map: "idx_revisions_submitted_by")
  @@map("submission_revisions")
  @@schema("origination")
}

model DocumentaryScreeningEvidence {
  id                   String    @id @map("evidence_id")
  caseId               String    @map("case_id")
  submissionRevisionId String    @map("submission_revision_id")
  documentType         String    @map("document_type")
  status               String    @default("pending")
  documentRef          String    @map("document_ref")
  extractDated         DateTime? @map("extract_dated") @db.Timestamptz(6)
  uploadedAt           DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  case               OriginationCase    @relation(fields: [caseId], references: [id])
  submissionRevision SubmissionRevision @relation(fields: [submissionRevisionId], references: [id])

  @@index([caseId], map: "idx_evidence_case")
  @@index([submissionRevisionId], map: "idx_evidence_revision")
  @@map("documentary_screening_evidence")
  @@schema("origination")
}

model WorkstreamAssignmentEvent {
  id                      String   @id @map("event_id")
  caseId                  String   @map("case_id")
  workstream              String
  eventType               String   @map("event_type")
  actorAccountId          String?  @map("actor_account_id")
  targetLegalPracticeId   String?  @map("target_legal_practice_id")
  targetAppraisalFirmId   String?  @map("target_appraisal_firm_id")
  targetReviewerAccountId String?  @map("target_reviewer_account_id")
  occurredAt              DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  case                OriginationCase @relation(fields: [caseId], references: [id])
  actor               Account?        @relation("WorkstreamActor", fields: [actorAccountId], references: [id])
  targetLegalPractice LegalPractice?  @relation(fields: [targetLegalPracticeId], references: [id])
  targetAppraisalFirm AppraisalFirm?  @relation(fields: [targetAppraisalFirmId], references: [id])
  targetReviewer      Account?        @relation("WorkstreamTargetReviewer", fields: [targetReviewerAccountId], references: [id])

  @@index([actorAccountId], map: "idx_workstream_events_actor")
  @@index([targetLegalPracticeId], map: "idx_workstream_events_target_practice")
  @@index([targetAppraisalFirmId], map: "idx_workstream_events_target_firm")
  @@index([targetReviewerAccountId], map: "idx_workstream_events_target_reviewer")
  @@index([caseId, workstream, occurredAt(sort: Desc)], map: "idx_workstream_events_case_stream")
  @@map("workstream_assignment_events")
  @@schema("origination")
}

model CaseIntegrityFlag {
  id                  String    @id @map("flag_id")
  caseId              String    @map("case_id")
  flagType            String    @map("flag_type")
  status              String    @default("open")
  raisedByAccountId   String?   @map("raised_by_account_id")
  raisedAt            DateTime  @default(now()) @map("raised_at") @db.Timestamptz(6)
  resolvedByAccountId String?   @map("resolved_by_account_id")
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote      String?   @map("resolution_note")

  case       OriginationCase @relation(fields: [caseId], references: [id])
  raisedBy   Account?        @relation("IntegrityFlagRaiser", fields: [raisedByAccountId], references: [id])
  resolvedBy Account?        @relation("IntegrityFlagResolver", fields: [resolvedByAccountId], references: [id])

  @@index([caseId, status], map: "idx_integrity_flags_case_status")
  @@index([raisedByAccountId], map: "idx_integrity_flags_raised_by")
  @@index([resolvedByAccountId], map: "idx_integrity_flags_resolved_by")
  @@map("case_integrity_flags")
  @@schema("origination")
}

model InformationRequest {
  id                   String    @id @map("request_id")
  caseId               String    @map("case_id")
  requestingWorkstream String    @map("requesting_workstream")
  proposedByAccountId  String    @map("proposed_by_account_id")
  proposedAt           DateTime  @default(now()) @map("proposed_at") @db.Timestamptz(6)
  status               String    @default("proposed")
  publishedByAccountId String?   @map("published_by_account_id")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  dueAt                DateTime? @map("due_at") @db.Timestamptz(6)
  requestBody          String    @map("request_body")
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionType       String?   @map("resolution_type")
  resolvingRevisionId  String?   @map("resolving_revision_id")

  case              OriginationCase     @relation(fields: [caseId], references: [id])
  proposedBy        Account             @relation("InformationRequestProposer", fields: [proposedByAccountId], references: [id])
  publishedBy       Account?            @relation("InformationRequestPublisher", fields: [publishedByAccountId], references: [id])
  resolvingRevision SubmissionRevision? @relation(fields: [resolvingRevisionId], references: [id])

  @@index([caseId, status], map: "idx_info_requests_case_status")
  @@index([status, dueAt], map: "idx_info_requests_status_due")
  @@index([proposedByAccountId], map: "idx_info_requests_proposed_by")
  @@index([publishedByAccountId], map: "idx_info_requests_published_by")
  @@index([resolvingRevisionId], map: "idx_info_requests_resolving_revision")
  @@map("information_requests")
  @@schema("origination")
}

model CaseThread {
  id     String @id @map("thread_id")
  caseId String @map("case_id")
  lane   String

  case     OriginationCase @relation(fields: [caseId], references: [id])
  messages CaseMessage[]

  @@unique([caseId, lane], map: "case_threads_case_id_lane_key")
  @@index([caseId], map: "idx_case_threads_case")
  @@map("case_threads")
  @@schema("origination")
}

model CaseMessage {
  id              String   @id @map("message_id")
  threadId        String   @map("thread_id")
  authorAccountId String?  @map("author_account_id")
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread CaseThread @relation(fields: [threadId], references: [id])
  author Account?   @relation(fields: [authorAccountId], references: [id])

  @@index([threadId, createdAt], map: "idx_case_messages_thread_created")
  @@index([authorAccountId], map: "idx_case_messages_author")
  @@map("case_messages")
  @@schema("origination")
}

model LegalExecutionEvent {
  id                   String    @id @map("execution_event_id")
  caseId               String    @map("case_id")
  eventType            String    @default("power_of_attorney") @map("event_type")
  requestedByAccountId String    @map("requested_by_account_id")
  ownerConfirmedAt     DateTime? @map("owner_confirmed_at") @db.Timestamptz(6)
  outcome              String?
  outcomeDocumentRef   String?   @map("outcome_document_ref")
  loggedAt             DateTime? @map("logged_at") @db.Timestamptz(6)

  case        OriginationCase @relation(fields: [caseId], references: [id])
  requestedBy Account         @relation(fields: [requestedByAccountId], references: [id])

  @@index([caseId], map: "idx_execution_events_case")
  @@index([requestedByAccountId], map: "idx_execution_events_requested_by")
  @@map("legal_execution_events")
  @@schema("origination")
}

model Piv {
  id                  String    @id @map("piv_id")
  propertyId          String    @unique @map("property_id")
  caseId              String    @map("case_id")
  legalName           String?   @map("legal_name")
  jurisdiction        String?
  registrationNo      String?   @map("registration_no")
  structurePattern    String    @default("default_aligned") @map("structure_pattern")
  corridorClearanceId String?   @map("corridor_clearance_id")
  aifGateStatus       String    @default("not_yet_cleared") @map("aif_gate_status")
  aifCounselMemoRef   String?   @map("aif_counsel_memo_ref")
  incorporatedAt      DateTime? @map("incorporated_at") @db.Timestamptz(6)
  deedTransferStatus  String?   @map("deed_transfer_status")
  tokenId             Decimal?  @unique @map("token_id") @db.Decimal(78, 0)

  property               Property                @relation(fields: [propertyId], references: [id])
  case                   OriginationCase         @relation(fields: [caseId], references: [id])
  corridorClearance      CorridorClearance?      @relation(fields: [corridorClearanceId], references: [id])
  offerings              Offering[]
  positions              PositionLedger[]
  rentCollections        RentCollection[]
  operatingDistributions OperatingDistribution[]

  @@index([corridorClearanceId], map: "idx_pivs_corridor_clearance")
  @@index([caseId], map: "idx_pivs_case")
  @@index([tokenId], map: "idx_pivs_token_id")
  @@map("pivs")
  @@schema("origination")
}

model Offering {
  id                       String    @id @map("offering_id")
  pivId                    String    @map("piv_id")
  minimumRaiseEur          Decimal   @map("minimum_raise_eur") @db.Decimal(15, 2)
  targetRaiseEur           Decimal   @map("target_raise_eur") @db.Decimal(15, 2)
  status                   String    @default("pre_offering")
  finalOfferingPublishedAt DateTime? @map("final_offering_published_at") @db.Timestamptz(6)
  platformRightsEndAt      DateTime? @map("platform_rights_end_at") @db.Timestamptz(6)
  effectiveRightsEndAt     DateTime? @map("effective_rights_end_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  piv                Piv                 @relation(fields: [pivId], references: [id])
  reservations       Reservation[]
  disclosurePacks    DisclosurePack[]
  materialityRecords MaterialityRecord[]

  @@index([pivId], map: "idx_offerings_piv")
  @@map("offerings")
  @@schema("offering")
}

model Reservation {
  id                                 String    @id @map("reservation_id")
  offeringId                         String    @map("offering_id")
  accountId                          String    @map("account_id")
  amountEur                          Decimal   @map("amount_eur") @db.Decimal(15, 2)
  reservationStage                   String    @default("initiated") @map("reservation_stage")
  disclosurePackVersionAtReservation String?   @map("disclosure_pack_version_at_reservation")
  reconfirmedAt                      DateTime? @map("reconfirmed_at") @db.Timestamptz(6)
  reservationFinalizedAt             DateTime? @map("reservation_finalized_at") @db.Timestamptz(6)
  createdAt                          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  offering    Offering         @relation(fields: [offeringId], references: [id])
  account     Account          @relation(fields: [accountId], references: [id])
  moneyEvents MoneyEvent[]
  positions   PositionLedger[]

  @@index([offeringId, reservationStage], map: "idx_reservations_offering_stage")
  @@index([accountId], map: "idx_reservations_account")
  @@map("reservations")
  @@schema("offering")
}

model DisclosurePack {
  id           String    @id @map("disclosure_pack_id")
  offeringId   String    @map("offering_id")
  version      Int
  publishedAt  DateTime  @map("published_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  isCurrent    Boolean   @default(true) @map("is_current")

  offering  Offering             @relation(fields: [offeringId], references: [id])
  documents DisclosureDocument[]

  @@unique([offeringId, version])
  @@map("disclosure_packs")
  @@schema("offering")
}

model DisclosureDocument {
  id               String  @id @map("document_id")
  disclosurePackId String  @map("disclosure_pack_id")
  documentType     String  @map("document_type")
  documentRef      String  @map("document_ref")
  isCoreReading    Boolean @default(true) @map("is_core_reading")

  disclosurePack DisclosurePack @relation(fields: [disclosurePackId], references: [id])

  @@index([disclosurePackId], map: "idx_disclosure_documents_pack")
  @@map("disclosure_documents")
  @@schema("offering")
}

model MaterialityRecord {
  id                    String   @id @map("materiality_record_id")
  offeringId            String   @map("offering_id")
  changeDescription     String   @map("change_description")
  classification        String
  thresholdType         String?  @map("threshold_type")
  resetTriggered        Boolean  @default(false) @map("reset_triggered")
  classifiedByAccountId String?  @map("classified_by_account_id")
  classifiedAt          DateTime @default(now()) @map("classified_at") @db.Timestamptz(6)

  offering     Offering @relation(fields: [offeringId], references: [id])
  classifiedBy Account? @relation(fields: [classifiedByAccountId], references: [id])

  @@index([offeringId], map: "idx_materiality_offering")
  @@index([classifiedByAccountId], map: "idx_materiality_classified_by")
  @@map("materiality_records")
  @@schema("offering")
}

model MoneyEvent {
  id                String    @id @map("money_event_id")
  reservationId     String    @map("reservation_id")
  provider          String
  providerReference String?   @map("provider_reference")
  capitalState      String    @map("capital_state")
  amountEur         Decimal   @map("amount_eur") @db.Decimal(15, 2)
  amountEurc        Decimal?  @map("amount_eurc") @db.Decimal(20, 6)
  recordedAt        DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  reconciledAt      DateTime? @map("reconciled_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId, recordedAt(sort: Desc)], map: "idx_money_events_reservation_recorded")
  @@map("money_events")
  @@schema("money")
}

model TreasurySweepBatch {
  id                     String    @id @map("sweep_batch_id")
  sweepDate              DateTime  @map("sweep_date") @db.Date
  netSweepableEur        Decimal   @map("net_sweepable_eur") @db.Decimal(15, 2)
  dualApprovalRef1       String?   @map("dual_approval_ref_1")
  dualApprovalRef2       String?   @map("dual_approval_ref_2")
  eligibilityConfirmedAt DateTime? @map("eligibility_confirmed_at") @db.Timestamptz(6)
  executedAt             DateTime? @map("executed_at") @db.Timestamptz(6)

  firstApprover  Account? @relation("FirstSweepApprover", fields: [dualApprovalRef1], references: [id])
  secondApprover Account? @relation("SecondSweepApprover", fields: [dualApprovalRef2], references: [id])

  @@index([dualApprovalRef1], map: "idx_sweep_batches_approval_ref_1")
  @@index([dualApprovalRef2], map: "idx_sweep_batches_approval_ref_2")
  @@map("treasury_sweep_batches")
  @@schema("money")
}

model Payout {
  id                       String    @id @map("payout_id")
  accountId                String    @map("account_id")
  amountEur                Decimal   @map("amount_eur") @db.Decimal(15, 2)
  amountEurc               Decimal   @map("amount_eurc") @db.Decimal(20, 6)
  destinationWalletAddress String    @map("destination_wallet_address")
  chainTxHash              String?   @map("chain_tx_hash")
  status                   String    @default("pending")
  requestedAt              DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  executedAt               DateTime? @map("executed_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "idx_payouts_account")
  @@map("payouts")
  @@schema("money")
}

model WalletRegistration {
  accountId              String    @id @map("account_id")
  walletAddress          String    @unique @map("wallet_address")
  registrationCommitment String    @map("registration_commitment")
  requestedAt            DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  registeredAt           DateTime? @map("registered_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@map("wallet_registrations")
  @@schema("settlement")
}

model PositionLedger {
  id                    String    @id @map("position_id")
  // Nullable: a position originated directly from an AD-256 IPO escrow
  // contribution has no Reservation at all -- that model belongs to the
  // separate onramp/reconfirmation purchase flow (AD-146/AD-214), which an
  // on-chain escrow contribution bypasses entirely. Still required (and
  // still the norm) for every position that *did* originate that way.
  reservationId         String?   @map("reservation_id")
  pivId                 String    @map("piv_id")
  accountId             String    @map("account_id")
  unitCount             Decimal   @map("unit_count") @db.Decimal(20, 6)
  costBasisEur          Decimal   @map("cost_basis_eur") @db.Decimal(15, 2)
  positionStatus        String    @default("pending_internal_settlement") @map("position_status")
  holderWalletAddress   String?   @map("holder_wallet_address")
  activatedAt           DateTime? @map("activated_at") @db.Timestamptz(6)
  redeemedAt            DateTime? @map("redeemed_at") @db.Timestamptz(6)
  redemptionProceedsEur Decimal?  @map("redemption_proceeds_eur") @db.Decimal(15, 2)

  reservation                  Reservation?                 @relation(fields: [reservationId], references: [id])
  piv                          Piv                          @relation(fields: [pivId], references: [id])
  account                      Account                      @relation(fields: [accountId], references: [id])
  chainEvents                  ChainSettlementEvent[]
  operatingDistributionEntries OperatingDistributionEntry[]

  @@index([reservationId], map: "idx_position_ledger_reservation")
  @@index([pivId], map: "idx_position_ledger_piv")
  @@index([accountId], map: "idx_position_ledger_account")
  @@map("position_ledger")
  @@schema("settlement")
}

model ChainSettlementEvent {
  id                   String    @id @map("chain_event_id")
  positionId           String?   @map("position_id")
  eventType            String    @map("event_type")
  tokenContractAddress String    @map("token_contract_address")
  tokenId              Decimal   @map("token_id") @db.Decimal(78, 0)
  chainTxHash          String    @map("chain_tx_hash")
  reconciledAt         DateTime? @map("reconciled_at") @db.Timestamptz(6)

  position PositionLedger? @relation(fields: [positionId], references: [id])

  @@index([positionId], map: "idx_chain_events_position")
  @@index([tokenContractAddress, tokenId], map: "idx_chain_events_contract_token")
  @@map("chain_settlement_events")
  @@schema("settlement")
}

// Minimal slice of AD-232's Rental domain boundary -- just enough to feed
// operating distributions below, not the full tenancy/lease/maintenance
// system AD-232 scoped but deliberately left unbuilt.
model RentCollection {
  id                    String   @id @map("rent_collection_id")
  pivId                 String   @map("piv_id")
  periodStart           DateTime @map("period_start") @db.Date
  periodEnd             DateTime @map("period_end") @db.Date
  grossRentCollectedEur Decimal  @map("gross_rent_collected_eur") @db.Decimal(15, 2)
  recordedBy            String   @map("recorded_by")
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes                 String?

  piv               Piv                    @relation(fields: [pivId], references: [id])
  recordedByAccount Account                @relation(fields: [recordedBy], references: [id])
  distribution      OperatingDistribution?

  @@unique([pivId, periodStart, periodEnd], map: "uq_rent_collections_piv_period")
  @@index([pivId], map: "idx_rent_collections_piv")
  @@map("rent_collections")
  @@schema("rental")
}

// Dormant by default -- gated behind OPERATING_DISTRIBUTION_ENABLED (see
// worker.ts), same pattern AD-234 already uses for the settlement layer
// itself. Nothing here pays out on its own; `approvedAt`/`approvedBy` is a
// real governance checkpoint before any entry moves to `paying`.
model OperatingDistribution {
  id                     String    @id @map("operating_distribution_id")
  pivId                  String    @map("piv_id")
  rentCollectionId       String    @unique @map("rent_collection_id")
  periodStart            DateTime  @map("period_start") @db.Date
  periodEnd              DateTime  @map("period_end") @db.Date
  recordDate             DateTime  @map("record_date") @db.Date
  grossRentEur           Decimal   @map("gross_rent_eur") @db.Decimal(15, 2)
  managementFeeEur       Decimal   @default(0) @map("management_fee_eur") @db.Decimal(15, 2)
  otherExpensesEur       Decimal   @default(0) @map("other_expenses_eur") @db.Decimal(15, 2)
  reserveHoldbackEur     Decimal   @default(0) @map("reserve_holdback_eur") @db.Decimal(15, 2)
  distributableNetEur    Decimal   @map("distributable_net_eur") @db.Decimal(15, 2)
  totalUnitsAtRecordDate Decimal   @map("total_units_at_record_date") @db.Decimal(20, 6)
  amountPerUnitEur       Decimal   @map("amount_per_unit_eur") @db.Decimal(15, 6)
  status                 String    @default("calculated") @map("status")
  calculatedAt           DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(6)
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy             String?   @map("approved_by")
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)

  piv               Piv                          @relation(fields: [pivId], references: [id])
  rentCollection    RentCollection               @relation(fields: [rentCollectionId], references: [id])
  approvedByAccount Account?                     @relation(fields: [approvedBy], references: [id])
  entries           OperatingDistributionEntry[]

  @@unique([pivId, periodStart, periodEnd], map: "uq_operating_distributions_piv_period")
  @@index([pivId], map: "idx_operating_distributions_piv")
  @@map("operating_distributions")
  @@schema("settlement")
}

model OperatingDistributionEntry {
  id                       String    @id @map("operating_distribution_entry_id")
  operatingDistributionId  String    @map("operating_distribution_id")
  positionId               String    @map("position_id")
  unitCountAtRecordDate    Decimal   @map("unit_count_at_record_date") @db.Decimal(20, 6)
  amountEurc               Decimal   @map("amount_eurc") @db.Decimal(15, 6)
  destinationWalletAddress String    @map("destination_wallet_address")
  chainTxHash              String?   @map("chain_tx_hash")
  paidAt                   DateTime? @map("paid_at") @db.Timestamptz(6)

  operatingDistribution OperatingDistribution @relation(fields: [operatingDistributionId], references: [id])
  position              PositionLedger        @relation(fields: [positionId], references: [id])

  @@unique([operatingDistributionId, positionId], map: "uq_distribution_entries_dist_position")
  @@index([operatingDistributionId], map: "idx_distribution_entries_distribution")
  @@index([positionId], map: "idx_distribution_entries_position")
  @@map("operating_distribution_entries")
  @@schema("settlement")
}

model AuditLog {
  id             String   @id @map("audit_log_id")
  eventKey       String?  @unique @map("event_key")
  actorAccountId String?  @map("actor_account_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  changes        Json?    @db.JsonB
  ipAddressHash  String?  @map("ip_address_hash")
  userAgentHash  String?  @map("user_agent_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Account? @relation(fields: [actorAccountId], references: [id])

  @@index([actorAccountId], map: "idx_audit_log_actor")
  @@index([resourceType, resourceId, createdAt(sort: Desc)], map: "idx_audit_log_resource")
  @@map("audit_log")
  @@schema("audit")
}

model IdempotencyKey {
  idempotencyKey  String   @map("idempotency_key")
  endpoint        String
  requestBodyHash String   @map("request_body_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body") @db.JsonB
  accountId       String?  @map("account_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id])

  @@id([idempotencyKey, endpoint])
  @@index([accountId], map: "idx_idempotency_keys_account")
  @@index([expiresAt], map: "idx_idempotency_keys_expires")
  @@map("idempotency_keys")
  @@schema("audit")
}

model PlatformSetting {
  key         String   @id @map("setting_key")
  value       Json     @db.JsonB
  description String
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by")

  updatedBy Account? @relation(fields: [updatedById], references: [id])

  @@index([updatedById], map: "idx_settings_updated_by")
  @@map("settings")
  @@schema("platform")
}
