model StaffWebAuthnCredential {
  id         String    @id @map("credential_id")
  accountId  String    @map("account_id")
  publicKey  Bytes     @map("public_key") @db.ByteA
  counter    BigInt    @default(0)
  deviceType String    @map("device_type")
  backedUp   Boolean   @default(false) @map("backed_up")
  transports String[]
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  account     Account           @relation(fields: [accountId], references: [id])
  mfaSessions StaffSessionMfa[]

  @@index([accountId], map: "idx_staff_webauthn_credentials_account")
  @@map("staff_webauthn_credentials")
  @@schema("auth")
}

model StaffWebAuthnChallenge {
  id                String    @id @map("challenge_id")
  accountId         String    @map("account_id")
  providerSessionId String    @map("provider_session_id")
  purpose           String
  challenge         String    @unique
  credentialLabel   String?   @map("credential_label")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, providerSessionId, purpose], map: "idx_staff_webauthn_challenges_session")
  @@index([expiresAt], map: "idx_staff_webauthn_challenges_expiry")
  @@map("staff_webauthn_challenges")
  @@schema("auth")
}

model StaffSessionMfa {
  providerSessionId String   @id @map("provider_session_id")
  accountId         String   @map("account_id")
  credentialId      String   @map("credential_id")
  verifiedAt        DateTime @map("verified_at") @db.Timestamptz(6)

  account    Account                 @relation(fields: [accountId], references: [id])
  credential StaffWebAuthnCredential @relation(fields: [credentialId], references: [id])

  @@index([accountId], map: "idx_staff_session_mfa_account")
  @@index([credentialId], map: "idx_staff_session_mfa_credential")
  @@map("staff_session_mfa")
  @@schema("auth")
}

model StaffInvitation {
  id                 String    @id @map("invitation_id")
  email              String
  displayName        String    @map("display_name")
  role               String
  legalPracticeId    String?   @map("legal_practice_id")
  appraisalFirmId    String?   @map("appraisal_firm_id")
  tokenHash          String    @unique @map("token_hash")
  invitedByAccountId String    @map("invited_by_account_id")
  acceptedAccountId  String?   @unique @map("accepted_account_id")
  claimId            String?   @map("claim_id")
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy       Account        @relation("StaffInvitationIssuer", fields: [invitedByAccountId], references: [id])
  acceptedAccount Account?       @relation("StaffInvitationAcceptance", fields: [acceptedAccountId], references: [id])
  legalPractice   LegalPractice? @relation(fields: [legalPracticeId], references: [id])
  appraisalFirm   AppraisalFirm? @relation(fields: [appraisalFirmId], references: [id])

  @@index([email], map: "idx_staff_invitations_email")
  @@index([expiresAt], map: "idx_staff_invitations_expiry")
  @@index([invitedByAccountId], map: "idx_staff_invitations_invited_by")
  @@map("staff_invitations")
  @@schema("auth")
}

model StaffRoleAssignment {
  id              String    @id @map("assignment_id")
  accountId       String    @map("account_id")
  role            String
  legalPracticeId String?   @map("legal_practice_id")
  appraisalFirmId String?   @map("appraisal_firm_id")
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  account       Account        @relation(fields: [accountId], references: [id])
  legalPractice LegalPractice? @relation(fields: [legalPracticeId], references: [id])
  appraisalFirm AppraisalFirm? @relation(fields: [appraisalFirmId], references: [id])

  @@index([accountId], map: "idx_staff_role_assignments_account")
  @@index([legalPracticeId], map: "idx_staff_role_assignments_legal_practice")
  @@index([appraisalFirmId], map: "idx_staff_role_assignments_appraisal_firm")
  @@map("staff_role_assignments")
  @@schema("auth")
}

model LoginMethod {
  id                 String   @id @map("login_method_id")
  accountId          String   @map("account_id")
  methodType         String   @map("method_type")
  providerSubject    String   @map("provider_subject")
  linkedAt           DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedViaFreshAuth Boolean  @default(true) @map("linked_via_fresh_auth")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, methodType])
  @@unique([methodType, providerSubject])
  @@map("login_methods")
  @@schema("auth")
}

model Session {
  id                     String    @id @map("session_id")
  accountId              String    @map("account_id")
  channel                String
  status                 String    @default("active")
  betterAuthUserId       String    @map("better_auth_user_id")
  betterAuthSessionId    String?   @map("better_auth_session_id")
  authMethodAtLogin      String    @map("auth_method_at_login")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt          DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt      DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastFreshAuthAt        DateTime? @map("last_fresh_auth_at") @db.Timestamptz(6)
  riskState              String    @default("normal") @map("risk_state")
  deviceLabel            String?   @map("device_label")
  userAgentHash          String?   @map("user_agent_hash")
  initialCountryCode     String?   @map("initial_country_code")
  lastCountryCode        String?   @map("last_country_code")
  networkMarkerHash      String?   @map("network_marker_hash")
  csrfSecretHash         String?   @map("csrf_secret_hash")
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason       String?   @map("revocation_reason")
  replacedBySessionId    String?   @map("replaced_by_session_id")

  account    Account   @relation(fields: [accountId], references: [id])
  replacedBy Session?  @relation("SessionReplacement", fields: [replacedBySessionId], references: [id])
  replaces   Session[] @relation("SessionReplacement")

  @@index([accountId, status], map: "idx_sessions_account_status")
  @@index([replacedBySessionId], map: "idx_sessions_replaced_by")
  @@map("sessions")
  @@schema("auth")
}

model AccountRecoveryCase {
  id                        String    @id @map("recovery_case_id")
  accountId                 String    @map("account_id")
  trigger                   String
  status                    String    @default("open")
  freshDiditVerificationRef String?   @map("fresh_didit_verification_ref")
  reviewedByPrimary         String?   @map("reviewed_by_primary")
  reviewedBySecondary       String?   @map("reviewed_by_secondary")
  cooldownEndsAt            DateTime? @map("cooldown_ends_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt                DateTime? @map("resolved_at") @db.Timestamptz(6)

  account           Account  @relation("RecoverySubject", fields: [accountId], references: [id])
  primaryReviewer   Account? @relation("PrimaryRecoveryReviewer", fields: [reviewedByPrimary], references: [id])
  secondaryReviewer Account? @relation("SecondaryRecoveryReviewer", fields: [reviewedBySecondary], references: [id])

  @@index([accountId], map: "idx_recovery_cases_account")
  @@index([reviewedByPrimary], map: "idx_recovery_cases_reviewed_primary")
  @@index([reviewedBySecondary], map: "idx_recovery_cases_reviewed_secondary")
  @@map("account_recovery_cases")
  @@schema("auth")
}

// Customer-initiated, staff-reviewed request to close an investment account.
// Deliberately single-reviewer (unlike AccountRecoveryCase's dual review):
// recovery's second reviewer exists to guard against a fraudulent takeover
// impersonating the account holder, a risk that doesn't apply here since the
// account is already authenticated and asking to leave voluntarily.
model AccountClosureRequest {
  id             String    @id @map("closure_request_id")
  accountId      String    @map("account_id")
  status         String    @default("pending")
  reason         String?
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by")
  resolutionNote String?   @map("resolution_note")

  account           Account  @relation("ClosureRequestSubject", fields: [accountId], references: [id])
  resolvedByAccount Account? @relation("ClosureRequestResolver", fields: [resolvedBy], references: [id])

  @@index([accountId], map: "idx_closure_requests_account")
  @@map("account_closure_requests")
  @@schema("auth")
}


// Replay protection for DPoP device-binding proofs: one row per (jkt, jti)
// pair actually seen, pruned once past expiresAt by a scheduled job. Reads
// (recordProof's INSERT ... ON CONFLICT) go through raw SQL for atomicity --
// this model exists for the typed prune query, not the hot insert path.
model DpopReplay {
  jkt       String
  jti       String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([jkt, jti])
  @@index([expiresAt], map: "idx_dpop_replays_expires_at")
  @@map("dpop_replays")
  @@schema("auth")
}

// A device-key-enrolled phone (device-bound biometric auth, step 1:
// single-device enrolment/login only -- no owner_address/owner_status/
// hold_until/push_token yet, those land with the Safe/pairing/push work).
// dpopJkt is unique: one device owns exactly one DPoP key, and that key is
// how requireAuthentication resolves which device a /v1 request belongs to.
model Device {
  deviceId             String   @id @map("device_id")
  accountId            String   @map("account_id")
  // Denormalized from Account.betterAuthUserId: better-auth's own
  // internalAdapter.createSession takes its userId, not our accountId, and
  // login (L2) has no session context to derive one from otherwise -- it's
  // 1:1 with accountId for a customer, so this avoids a join on every login.
  betterAuthUserId     String   @map("better_auth_user_id")
  dpopJkt              String   @unique @map("dpop_jkt")
  bioJkt               String   @map("bio_jkt")
  biometricPublicJwk   Json     @map("biometric_public_jwk")
  platform             String
  model                String?
  osVersion            String?  @map("os_version")
  appVersion           String?  @map("app_version")
  attestationMetadata  Json     @map("attestation_metadata")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt           DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "idx_devices_account")
  @@map("devices")
  @@schema("auth")
}

// Single-use challenges for the device-auth JWS ceremony (enrol/login).
// Consumed atomically (consumedAt set only once, via a conditional update),
// same discipline as DpopReplay's insert-once but for a value the server
// issues rather than one the client picks.
model DeviceChallenge {
  challenge  String    @id
  purpose    String
  dpopJkt    String    @map("dpop_jkt")
  deviceId   String?   @map("device_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_device_challenges_expires_at")
  @@map("device_challenges")
  @@schema("auth")
}
